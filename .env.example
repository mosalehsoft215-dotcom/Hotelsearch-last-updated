# Copy to .env and fill in. .env is gitignored — keep it that way.

# Yarvel / Hasura. YARVEL_SECRET is the Hasura admin secret.
YARVEL_URL=https://dev-hasura.tripon.io/v1/graphql
YARVEL_SECRET=
YARVEL_ORG_ID=
YARVEL_AGENCY_ID=
# Only needed for the JWT path (login.py, HOTELS_AUTH_MODE=forward_jwt).
YARVEL_USERNAME=
YARVEL_PASSWORD=
# loginRihla rejects requests without this header. Get yours with `curl ifconfig.me`.
TRIPON_SENDER_IP=

# admin_secret for dev, forward_jwt to pass the caller's token through.
HOTELS_AUTH_MODE=admin_secret
HOTELS_REFRESH_WINDOW_MINUTES=30
HOTELS_REQUEST_TIMEOUT=30
HOTELS_TRANSPORT=stdio

# Used when a request omits them. Nationality changes supplier pricing, so pass
# the customer's real one per request rather than leaning on this.
HOTELS_DEFAULT_CURRENCY=USD
HOTELS_DEFAULT_NATIONALITY=US
HOTELS_AVAILABILITY_MAX_POLLS=6
HOTELS_AVAILABILITY_POLL_SECONDS=1.0
HOTELS_AGENT_MAX_ITERATIONS=8

# LLM (OpenRouter). The first model is the console's default; the key must be on
# an account that can pay for the model it names.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_MAX_TOKENS=4000
# Alternates the chat page can switch to. Separate accounts, so each carries its
# own key. Drop or add the :free suffix if an account rejects the name — the
# client retries the other spelling once on its own.
OPENROUTER_MODEL_B=
OPENROUTER_API_KEY_B=
OPENROUTER_MODEL_C=
OPENROUTER_API_KEY_C=

# Durable memory. local = in-process (no infrastructure). graphiti = FalkorDB + graphiti_core.
MEMORY_BACKEND=local
MEMORY_TOP_K=8
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GRAPHITI_LLM_MODEL=anthropic/claude-haiku-4.5
# Graphiti also needs embeddings, which OpenRouter does not serve. "local" is the
# hashed embedder in graphiti_embedder.py; "openai" needs a real endpoint below.
GRAPHITI_EMBEDDER=local
GRAPHITI_EMBEDDER_API_KEY=
GRAPHITI_EMBEDDER_BASE_URL=
GRAPHITI_EMBEDDER_MODEL=text-embedding-3-small

# Web enrichment. "openrouter" reuses OPENROUTER_API_KEY above; "none" leaves
# only the weather provider, and the rest say so instead of inventing.
WEB_SEARCH_BACKEND=none
WEB_SEARCH_MODEL=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CACHE_SECONDS=3600
WEB_OPENMETEO_ENABLED=true
# Needs requirements-playwright.txt and `playwright install chromium`.
WEB_PLAYWRIGHT_ENABLED=false
ENRICHMENT_INDEX_PATH=enrichment_index.sqlite3
